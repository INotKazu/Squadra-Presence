{
  "name": "squadra-cloud-vault",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create squadra-cloud-vault --binding DB --update-config",
    "db:local": "wrangler d1 execute squadra-cloud-vault --local --file=schema.sql",
    "db:remote": "wrangler d1 execute squadra-cloud-vault --remote --file=schema.sql",
    "test": "vitest run test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.127.1"
  }
}
